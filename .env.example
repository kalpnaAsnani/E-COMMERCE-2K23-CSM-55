# Student: Kalpna Asnani (Roll No: 2k23/CSM/55)
# Course: E-Commerce, Department of Computer Science / AI, University of Sindh

NODE_ENV=development
PORT=5000
JWT_SECRET=terracraft_super_secure_jwt_secret_university_exam_2026
JWT_EXPIRES_IN=24h

# PostgreSQL Configuration (for live PostgreSQL instances)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/terracraft_db
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=terracraft_db

# Offline / In-Memory Mode
# Set to 'true' to execute zero-dependency catalog engine without requiring PostgreSQL server
USE_IN_MEMORY_DB=true
